# DigiPost Environment Configuration

# Application Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL 14+)
DATABASE_URL=postgres://postgres:your_password@127.0.0.1:5432/digipost_dev
TEST_DATABASE_URL=postgres://postgres:your_password@127.0.0.1:5432/digipost_test

# Storage Configuration
UPLOAD_DIR=./uploads/documents
MAX_FILE_SIZE_MB=25

# Session & Security
COOKIE_SECRET=digipost-super-secret-cookie-key-development-only-replace-in-production
SESSION_COOKIE_NAME=digipost_session
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8

# SMTP Email Adapter (Development defaults to console/local log)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@digipost.local


# =========================================================
# DigiPost - Konfigurasi Lingkungan Docker & Dokploy
# Salin berkas ini ke .env sebelum menjalankan docker compose
# Atau masukkan variabel ini pada menu Environment Variables di Dokploy
# =========================================================

NODE_ENV=development

# Pengaturan Port Host
PORT=4000
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5432
MAILPIT_PORT=8025

# ---------------------------------------------------------
# Opsi 1: Menggunakan Database Eksternal (Supabase, Neon, AWS RDS, Dokploy DB, dsb.)
# Jika DATABASE_URL diisi, aplikasi akan langsung terhubung ke database eksternal ini.
# ---------------------------------------------------------
# DATABASE_URL=postgres://username:password@external-db-host:5432/dbname?sslmode=require
# DATABASE_SSL=true

# ---------------------------------------------------------
# Opsi 2: Menggunakan Database PostgreSQL Internal Docker Compose (Default)
# ---------------------------------------------------------
POSTGRES_DB=digipost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=digipost_secret_pass

# Keamanan Sesi Cookie (Minimal 32 karakter acak untuk produksi)
COOKIE_SECRET=digipost-super-secure-production-random-secret-key-32chars
SESSION_COOKIE_NAME=digipost_session

# Otomatisasi Seeding Data Awal (false = migrasi skema saja, true = isi akun demo & master departemen)
SEED_ON_START=false

# Batas Ukuran Unggah Berkas (MB)
MAX_FILE_SIZE_MB=25

# Pengaturan Sesi (Menit & Jam)
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8

# Pengaturan Email SMTP (Opsional, untuk fitur reset password)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@digipost.local
